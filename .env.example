# Copie este ficheiro para .env e ajuste os valores.
# O Vite só expõe variáveis com o prefixo VITE_.

# Origem dos dados: "mock" (dados fictícios) ou "api" (FastAPI do backend).
VITE_DATA_SOURCE=mock

# URL base da API (sem barra final). Usada só quando VITE_DATA_SOURCE=api.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Tempo máximo de espera por pedido, em milissegundos.
VITE_API_TIMEOUT_MS=10000

# Latência simulada do mock (ms). Útil para ver os estados de carregamento.
VITE_MOCK_LATENCY_MS=0
